{
  "name": "@flash-sale/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env --import ./dist/instrumentation.js dist/main.js",
    "dev": "tsc-watch --noClear --onSuccess \"node --env-file-if-exists=../../.env --import ./dist/instrumentation.js dist/main.js\"",
    "dev:debug": "tsc-watch --noClear --onSuccess \"node --env-file-if-exists=../../.env --import ./dist/instrumentation.js --inspect-brk=9230 dist/main.js\""
  },
  "dependencies": {
    "@flash-sale/db": "workspace:^",
    "@flash-sale/shared": "workspace:*",
    "@flash-sale/telemetry": "workspace:*",
    "@flash-sale/telemetry-gcp": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@xenova/transformers": "^2.17.2",
    "bullmq": "^5.78.1",
    "ioredis": "5.10.1",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.2",
    "stripe": "^22.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "pino-pretty": "^13.1.3",
    "tsc-watch": "^6.2.1"
  }
}
