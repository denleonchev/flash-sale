# Example environment for the flash-sale platform.
# Copy to .env and fill in real values. NEVER commit the real .env (it is
# git-ignored). Every secret comes from here — nothing is hardcoded (NFR-8).

# ─────────────────────────────────────────────────────────────────────────────
# Local development
#
#   apps (web/api/worker) run on the HOST via pnpm;
#   `docker compose up` brings up Postgres (+pgvector) and Redis locally.
#
# The DATABASE_URL / REDIS_URL below point at those local containers.
# ─────────────────────────────────────────────────────────────────────────────

# App ports (apps read these; web/api are published, worker is health-only).
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002

# SSR fetch from web to api (Next.js server → Nest server). Override in Docker to
# use the container service name (e.g. http://api:3001).
API_INTERNAL_URL=http://localhost:3001

# Where the BROWSER opens its Socket.IO connection (api). In prod leave unset —
# Caddy routes /socket.io on the page's own origin, so api's address is never
# exposed. In dev there is no Caddy, so point this straight at api.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Local Postgres container — these are consumed by docker-compose.yml AND must
# match the credentials in DATABASE_URL below.
POSTGRES_USER=flash
POSTGRES_PASSWORD=flash
POSTGRES_DB=flash_sale

# Connection strings (local containers on localhost).
# Prisma migrations need the DIRECT connection (port 5432) — see packages/db/CLAUDE.md.
DATABASE_URL=postgresql://flash:flash@localhost:5432/flash_sale?schema=public
REDIS_URL=redis://localhost:6379

# HMAC secrets shared between web and api (NFR-7, NFR-9) — same value must be set
# in both. SOCKET_TICKET_SECRET signs the short-lived ticket a browser presents to
# open its Socket.IO connection; ADMIN_TICKET_SECRET signs the `X-Admin-Ticket`
# header the web BFF sends for admin-only api calls. Generate with `openssl rand
# -hex 32`.
SOCKET_TICKET_SECRET=
ADMIN_TICKET_SECRET=

# Auth0 — buyer sign-in for the web BFF (S-2.5, FR-6). Create a Regular Web App in
# the Auth0 dashboard; callback http://localhost:3000/auth/callback, logout
# http://localhost:3000. AUTH0_SECRET encrypts the session cookie (`openssl rand -hex 32`).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Separate Auth0 Machine-to-Machine app, authorized for the Management API —
# used only by the dev/demo role switcher (assigns/revokes the "admin"/"moderator"
# role on the signed-in user). Different app than AUTH0_CLIENT_ID/SECRET above.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# GCP observability — OpenTelemetry tracing + trace-correlated logs (api/worker/web).
# Must match the Terraform project_id for this VM's environment (stage vs prod differ).
# Unset locally: spans are dropped (no-op processor), not sent anywhere. Set
# DEBUG_TRACES=1 to print them to the console instead, e.g. when diagnosing trace
# propagation across web/api/worker.
# ─────────────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
DEBUG_TRACES=

# ─────────────────────────────────────────────────────────────────────────────
# Groq — AI text generation (off the purchase path). Used by api to improve sale
# copy. Get a free key at console.groq.com. GROQ_MODEL defaults to
# llama-3.3-70b-versatile if unset.
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────────────────────────────────────
# Stripe — real payment in test mode (FR-12 [Ext]).
#
# Keys are test-mode only (sk_test_… / pk_test_…) — no real money is charged.
# STRIPE_WEBHOOK_SECRET verifies the webhook signature (api throws without it);
# get it from `stripe listen --forward-to localhost:3001/webhooks/stripe` locally,
# or the Dashboard's webhook endpoint settings in a deployed environment.
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# ─────────────────────────────────────────────────────────────────────────────
# Production (docker-compose.prod.yml)
#
#   apps run in docker-compose on a single host; databases are EXTERNAL managed
#   services (technical-design §8). Override the two URLs below — leave the rest.
#
#   Supabase: use the DIRECT connection (port 5432) for migrations.
#   Upstash:  use the TLS scheme (rediss://).
#
#   stage and prod are two separate VMs, each with its own .env on disk: DOMAIN,
#   AUTH0_CLIENT_ID/SECRET, DATABASE_URL, REDIS_URL, STRIPE_SECRET_KEY,
#   STRIPE_WEBHOOK_SECRET must differ between them (separate Auth0 clients,
#   separate Supabase/Upstash instances, separate Stripe test keys and webhook
#   endpoints — the matching publishable key is baked into the web image at
#   build time per-environment, see publish.yml). GROQ_API_KEY can be shared.
#
#   WEB_IMAGE_TAG pins which web image tag this VM's docker-compose pulls —
#   "stage-latest" on the stage VM, "prod-latest" on the prod VM (web is the only
#   image built per-environment; api/worker share a single "latest").
#
#   To test the prod stack locally instead (docker-compose.local-prod.yml, images
#   built from local Dockerfiles): DOMAIN=localhost — Caddy then serves plain HTTP,
#   no TLS.
# ─────────────────────────────────────────────────────────────────────────────
# DOMAIN=stage.example.com     # prod VM: DOMAIN=example.com — Caddy's TLS cert name
# DATABASE_URL=postgresql://postgres:<password>@<project>.supabase.com:5432/postgres
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# WEB_IMAGE_TAG=stage-latest   # prod VM: WEB_IMAGE_TAG=prod-latest

# ─────────────────────────────────────────────────────────────────────────────
# Concurrency test harness (optional, dev-only) — S-E0.5.
#
# Only read by `pnpm --filter @flash-sale/db test:integration:stripe-concurrency`
# (fires CONCURRENCY_BUYERS real Stripe test-mode buyers at CONCURRENCY_STOCK
# units to verify no oversell under load). Everything below has a built-in
# default — uncomment only to override. Needs STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET above, and api running at API_URL.
# ─────────────────────────────────────────────────────────────────────────────
# CONCURRENCY_STOCK=5
# CONCURRENCY_BUYERS=50
# API_URL=http://localhost:3001
